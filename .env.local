# Configuration pour l'application Exoscope

# URL de base pour le visualisateur éducatif d'exoplanètes
NEXT_PUBLIC_EDUCATIONAL_VISUALIZER_BASE_URL=https://visualize3-d.vercel.app

# URL du backend API
NEXT_PUBLIC_BACKEND_URL=https://backend-space.onrender.com

# URL de l'API de classification d'exoplanètes
NEXT_PUBLIC_CLASSIFICATION_API_URL=https://modelnyxai.onrender.com

